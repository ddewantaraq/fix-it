{
  "name": "fix-it",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @fix-it/shared",
    "dev:api": "npm run dev -w @fix-it/api",
    "dev:web": "npm run dev -w @fix-it/web",
    "build": "npm run build -w @fix-it/shared && npm run build -w @fix-it/api && npm run build -w @fix-it/web",
    "smoke:meta": "npm run smoke:meta -w @fix-it/api"
  },
  "engines": {
    "node": ">=20"
  }
}
